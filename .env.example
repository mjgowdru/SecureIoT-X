# ============================================================
# SecureIoT-X Environment Configuration
# ============================================================
# Copy this file to .env and fill in your values
# NEVER commit .env to version control
# ============================================================

# Application
APP_NAME=SecureIoT-X
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO

# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# Frontend
FRONTEND_PORT=3000

# Database (SQLite default, switch to PostgreSQL for production)
DATABASE_URL=sqlite:///./secureiot.db
# DATABASE_URL=postgresql://secureiot:secureiot_pass@localhost:5432/secureiot_db

# JWT Authentication
JWT_SECRET_KEY=CHANGE_THIS_TO_A_RANDOM_SECRET_KEY_MIN_32_CHARS
JWT_ALGORITHM=HS256
JWT_EXPIRY_MINUTES=60

# MQTT Broker
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_KEEPALIVE=60

# Default Admin (created on first run)
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=SecureIoT2024!
DEFAULT_ADMIN_EMAIL=admin@secureiot.local

# AI Engine
ML_MODELS_DIR=models
ML_DATASET_PATH=datasets/RT_IOT2022.csv
ML_RANDOM_SEED=42
ML_TEST_SIZE=0.2
ML_VALIDATION_SIZE=0.1

# Blockchain
BLOCKCHAIN_DIFFICULTY=2
BLOCKCHAIN_DB_PATH=blockchain_ledger.json

# SDN Mode (mock / ryu)
SDN_MODE=mock
RYU_HOST=localhost
RYU_PORT=6633

# Email Notifications (optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=alerts@secureiot.local
